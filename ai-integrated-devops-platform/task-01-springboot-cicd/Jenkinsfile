pipeline {
    agent any

    environment {
        IMAGE_NAME = 'zeyaurrahman/incident-management'
        IMAGE_TAG = 'v1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                dir('ai-integrated-devops-platform/task-01-springboot-cicd') {
                    bat 'mvnw.cmd clean package'
                }
            }
        }
         stage('Test Docker Connection') {
            steps {    
                bat '''
                    docker context show
                    docker ps
                    docker version
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('ai-integrated-devops-platform/task-01-springboot-cicd') {
                    bat 'set DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine && docker build -t %IMAGE_NAME%:%IMAGE_TAG% .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_PASSWORD'
                )]) {
                    bat 'powershell -NoProfile -NonInteractive -Command "$env:DOCKERHUB_PASSWORD | docker login -u $env:DOCKERHUB_USER --password-stdin"'
                    bat 'docker push %IMAGE_NAME%:%IMAGE_TAG%'
                    bat 'docker logout'
                }
            }
        }

        stage('Verify Kubernetes Access') {
            steps {
                bat '"C:\\Program Files\\kubectl\\kubectl.exe" --kubeconfig="C:\\Windows\\System32\\config\\systemprofile\\.kube\\config" get nodes'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat '"C:\\Program Files\\kubectl\\kubectl.exe" --kubeconfig="C:\\Windows\\System32\\config\\systemprofile\\.kube\\config" set image deployment/incident-management incident-management=%IMAGE_NAME%:%IMAGE_TAG%'
                bat '"C:\\Program Files\\kubectl\\kubectl.exe" --kubeconfig="C:\\Windows\\System32\\config\\systemprofile\\.kube\\config" rollout status deployment/incident-management --timeout=120s'
            }
        }
    }
}
